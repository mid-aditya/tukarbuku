# ── Database ────────────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:5432/tukarbuku
# Pastikan database "tukarbuku" sudah dibuat di PostgreSQL sebelum migrate.
DATABASE_URL=

# ── Auth.js ─────────────────────────────────────────────────────────────
# secret untuk menandatangani session cookie. Generate dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Buat project di https://console.cloud.google.com/ → APIs & Services → Credentials → OAuth 2.0 Client IDs
# Redirect URI yang perlu ditambahkan di GCP: {ORIGIN}/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── App ──────────────────────────────────────────────────────────────────
# Origin lengkap termasuk protokol dan port. Contoh: http://localhost:5173
ORIGIN=http://localhost:5173
