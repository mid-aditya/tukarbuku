# PostgreSQL connection string. Never commit a real value.
DATABASE_URL=postgresql://user:password@localhost:5432/tukarbuku

# Required before enabling Google OAuth routes.
AUTH_SECRET=replace-with-a-long-random-value
AUTH_GOOGLE_ID=replace-with-google-client-id
AUTH_GOOGLE_SECRET=replace-with-google-client-secret

# Public origin used for OAuth callback and absolute links.
ORIGIN=http://localhost:5173
